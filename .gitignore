# Data — what came from outside. Reproducible by re-rendering the download section.
data/

# Objects the document writes as it goes, and re-reads instead of recomputing.
*.h5ad

# Quarto
/.quarto/
/_freeze/
*_files/
*.quarto_ipynb

# The gfm figures are the exception: report.md is committed so the analysis can be
# read on GitHub, and a markdown file carries its figures as files beside it rather
# than inline. Git will not re-include a path whose parent is excluded, so the
# parent directory has to be reopened before the one subdirectory is let back in.
!oir_analysis_files/
oir_analysis_files/*
!oir_analysis_files/figure-commonmark/

# The rendered report and deck are outputs of the .qmd, not sources. report.md is
# committed instead of ignored, being the copy GitHub renders.
*.html
*.pptx

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS
.DS_Store

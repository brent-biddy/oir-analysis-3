# Data — what came from outside. Reproducible by re-rendering the download section.
data/

# Objects the document writes as it goes, and re-reads instead of recomputing.
*.h5ad

# Quarto
/.quarto/
/_freeze/
*.quarto_ipynb

# Everything rendered lands in reports/. The markdown and the figures beside it are
# committed, being the copy GitHub renders; the html and the deck are not, being the
# same content in formats git has nothing useful to say about.
*.html
*.pptx

# A render that forgot --output-dir, which belongs in reports/ rather than here.
/*_files/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS
.DS_Store

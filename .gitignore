# Data — what came from outside. Reproducible by re-rendering the download section.
data/

# Objects the document writes as it goes, and re-reads instead of recomputing.
*.h5ad

# Quarto
/.quarto/
/_freeze/
*.quarto_ipynb

# Everything rendered lands in reports/. The markdown and the figures beside it are
# committed, being the copy GitHub renders; the deck is not, being the same content in
# a format git has nothing useful to say about. Rebuild it by rendering.
*.pptx

# The template the deck is rendered from is an input, not a render, so it is committed
# even though it is a deck.
!assets/*.pptx

# A render that landed here rather than in reports/, where output-dir puts it.
/*_files/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS
.DS_Store
